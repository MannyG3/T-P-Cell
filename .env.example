NEXT_PUBLIC_SUPABASE_URL=https://nmjxslvyqalivllepqwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (never prefix with NEXT_PUBLIC_). Needed for importing/deleting
# student and alumni accounts and for `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Shared secret Vercel Cron sends to /api/cron/keep-alive.
CRON_SECRET=generate-a-long-random-string

# Public site URL used in emailed links (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=https://t-and-p-app.vercel.app

# Seeds (npm run seed:tpo / npm run seed). Never commit real values.
DEMO_TPO_EMAIL=tpo@yourinstitute.edu
DEMO_TPO_NAME=TPO Admin
DEMO_TPO_PASSWORD=choose-a-strong-password
DEMO_USER_PASSWORD=password-for-demo-students
